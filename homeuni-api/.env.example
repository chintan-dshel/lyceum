# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://lyceum:lyceum_pass@localhost:5432/lyceum_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# ElevenLabs (Phase 2 — voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# OpenAI Whisper (Phase 2 — STT)
OPENAI_API_KEY=

# Difficulty detection thresholds
DIFFICULTY_LESSON_TIME_MULTIPLIER=2
DIFFICULTY_LESSON_REOPEN_COUNT=3
DIFFICULTY_ASSIGNMENT_SCORE_THRESHOLD=60
DIFFICULTY_EXAM_SCORE_THRESHOLD=50
DIFFICULTY_SESSION_GAP_DAYS=3
DIFFICULTY_NUDGE_COOLDOWN_HOURS=48

# SMTP (optional — email streak reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@lyceum.ai
CLIENT_URL=http://localhost:5173
